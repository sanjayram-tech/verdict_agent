# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------- Jira
# Jira Cloud site, e.g. https://your-site.atlassian.net
JIRA_BASE_URL=
# Atlassian account email and API token (https://id.atlassian.com/manage-profile/security/api-tokens)
# Tip: use a read-only account/token for running the agent; the importer needs create permissions.
JIRA_EMAIL=
JIRA_API_TOKEN=
# Optional: issue type and link type used by the importer
JIRA_ISSUE_TYPE=Task
JIRA_LINK_TYPE=Relates

# ---------------------------------------------------------------- Model (any provider)
# LLM_PROVIDER: gemini | anthropic | openai | openrouter | groq | deepseek | mistral | together | ollama
#   gemini / anthropic use the native SDKs.
#   openai = any OpenAI-compatible endpoint (set LLM_BASE_URL for Azure, vLLM, LM Studio, ...);
#   openrouter/groq/deepseek/mistral/together/ollama are presets of `openai` with the base URL filled in.
# The model must support tool/function calling.
LLM_PROVIDER=gemini
# Model id for that provider. Defaults: gemini -> gemini-2.5-flash, anthropic -> claude-opus-5-5.
# Required for the OpenAI-compatible providers.
LLM_MODEL=
# API key. If empty, the provider's own variable is used instead:
#   GEMINI_API_KEY, ANTHROPIC_API_KEY, OPENAI_API_KEY, OPENROUTER_API_KEY, GROQ_API_KEY,
#   DEEPSEEK_API_KEY, MISTRAL_API_KEY, TOGETHER_API_KEY. Ollama/local servers need no key.
LLM_API_KEY=
# Optional custom endpoint (OpenAI-compatible servers, proxies, Azure).
LLM_BASE_URL=

# Optional tuning
# LLM_TEMPERATURE: gemini defaults to 0. For openai-compatible it is unset (some reasoning models reject it).
# Ignored for anthropic (current Claude models reject sampling parameters).
LLM_TEMPERATURE=
# LLM_MAX_TOKENS: per-response cap (anthropic default 16000; others use the server default)
LLM_MAX_TOKENS=
# LLM_EFFORT: anthropic only - low | medium | high | xhigh | max
LLM_EFFORT=
# ANTHROPIC_FALLBACKS: server-side refusal fallback on supported Claude models (1 = on, 0 = off)
ANTHROPIC_FALLBACKS=1
# LLM_MIN_INTERVAL_S: seconds between model calls. Use ~6 on free tiers (about 10 requests/minute).
LLM_MIN_INTERVAL_S=0

# ---------------------------------------------------------------- Examples
# Gemini:      LLM_PROVIDER=gemini     LLM_MODEL=gemini-2.5-flash   GEMINI_API_KEY=...
# Claude:      LLM_PROVIDER=anthropic  LLM_MODEL=claude-opus-5-5    ANTHROPIC_API_KEY=...
# OpenAI:      LLM_PROVIDER=openai     LLM_MODEL=<model id>         OPENAI_API_KEY=...
# OpenRouter:  LLM_PROVIDER=openrouter LLM_MODEL=<vendor/model>     OPENROUTER_API_KEY=...
# Local:       LLM_PROVIDER=ollama     LLM_MODEL=<tool-capable model, e.g. qwen3>
# Azure/vLLM:  LLM_PROVIDER=openai     LLM_BASE_URL=https://...     LLM_MODEL=...  LLM_API_KEY=...
